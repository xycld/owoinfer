// out[M,N] = A[M,K] * B[N,K]^T without cooperative matrices, for any device with buffer device addresses and 64-bit
// integers: fp32 accumulators with K ascending, inputs f16 or bf16. A and B are row-major with strides lda and ldb, both
// multiples of 4. M is free; N and K are multiples of 4. It does not depend on the subgroup size.
//
// Each invocation computes 4 adjacent output columns of one row, in tiles of 8 rows by 32 columns. MODE:
//   0: out is f32
//   1: out is bf16
//   2: out[m,n] += bf16(bf16(ab) * gate[n]), gated residual, bf16 in place
//   3: out[m,n] = situ(bf16(A * B[n]), bf16(A * B[N + n])), SiTU-GLU over the stored [hidden | gate] weight, bf16
#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 0) const bool INPUT_BF16 = true;
layout(constant_id = 1) const int MODE = 0;

layout(push_constant) uniform PC {
  uint64_t a;
  uint64_t b;
  uint64_t out_;
  uint64_t gate;
  uint M;
  uint N;
  uint K;
  uint lda;
  uint ldb;
  uint ldo;
} pc;

vec4 decode(uvec2 w) { return INPUT_BF16 ? f4(w) : vec4(unpackHalf2x16(w.x), unpackHalf2x16(w.y)); }

// exp(-2 |x|) stays in range where GLSL's tanh may divide infinities; beyond 12 the result rounds to 1 in fp32 anyway.
vec4 tanh_safe(vec4 x) {
  const vec4 e = exp(-2.0 * min(abs(x), vec4(12.0)));
  precise const vec4 t = (1.0 - e) / (1.0 + e);
  return sign(x) * t;
}

vec4 situ(vec4 h, vec4 g) {
  const float inv25 = 1.0 / 25.0;  // torch divides by a CPU scalar as a multiply by its fp32 reciprocal
  precise const vec4 g_quarter = g * 0.25;
  const vec4 tanh_g = rbf4(tanh_safe(rbf4(g_quarter)));
  precise const vec4 four_tanh = 4.0 * tanh_g;
  precise const vec4 sigmoid = 1.0 / (1.0 + exp(-g));
  precise const vec4 left = rbf4(four_tanh) * rbf4(sigmoid);
  precise const vec4 h_scaled = h * inv25;
  const vec4 tanh_h = rbf4(tanh_safe(rbf4(h_scaled)));
  precise const vec4 right = 25.0 * tanh_h;
  precise const vec4 product = rbf4(left) * rbf4(right);
  return product;
}

void main() {
  const uint inv = gl_LocalInvocationIndex;
  const uint m = gl_WorkGroupID.y * 8u + inv / 8u;
  const uint n = (gl_WorkGroupID.x * 8u + inv % 8u) * 4u;
  if (m >= pc.M || n >= pc.N) return;

  Words A = Words(pc.a + uint64_t(m) * pc.lda * 2ul);
  const uint64_t ldb_bytes = uint64_t(pc.ldb) * 2ul;
  const uint64_t b0 = pc.b + uint64_t(n) * ldb_bytes;
  Words B0 = Words(b0), B1 = Words(b0 + ldb_bytes), B2 = Words(b0 + 2ul * ldb_bytes), B3 = Words(b0 + 3ul * ldb_bytes);
  const uint64_t g0 = pc.b + uint64_t(pc.N + n) * ldb_bytes;
  Words G0 = Words(g0), G1 = Words(g0 + ldb_bytes), G2 = Words(g0 + 2ul * ldb_bytes), G3 = Words(g0 + 3ul * ldb_bytes);

  precise vec4 acc = vec4(0.0), acc_gate = vec4(0.0);
  const uint words = pc.K / 4u;
  for (uint i = 0u; i < words; ++i) {
    const vec4 x = decode(A.d[i]);
    const vec4 c0 = decode(B0.d[i]), c1 = decode(B1.d[i]), c2 = decode(B2.d[i]), c3 = decode(B3.d[i]);
    acc = acc + x.x * vec4(c0.x, c1.x, c2.x, c3.x);
    acc = acc + x.y * vec4(c0.y, c1.y, c2.y, c3.y);
    acc = acc + x.z * vec4(c0.z, c1.z, c2.z, c3.z);
    acc = acc + x.w * vec4(c0.w, c1.w, c2.w, c3.w);
    if (MODE == 3) {
      const vec4 d0 = decode(G0.d[i]), d1 = decode(G1.d[i]), d2 = decode(G2.d[i]), d3 = decode(G3.d[i]);
      acc_gate = acc_gate + x.x * vec4(d0.x, d1.x, d2.x, d3.x);
      acc_gate = acc_gate + x.y * vec4(d0.y, d1.y, d2.y, d3.y);
      acc_gate = acc_gate + x.z * vec4(d0.z, d1.z, d2.z, d3.z);
      acc_gate = acc_gate + x.w * vec4(d0.w, d1.w, d2.w, d3.w);
    }
  }

  if (MODE == 0) {
    Floats out_f = Floats(pc.out_ + (uint64_t(m) * pc.ldo + n) * 4ul);
    out_f.d[0] = acc.x;
    out_f.d[1] = acc.y;
    out_f.d[2] = acc.z;
    out_f.d[3] = acc.w;
    return;
  }
  Words out_w = Words(pc.out_ + (uint64_t(m) * pc.ldo + n) * 2ul);
  if (MODE == 1) {
    out_w.d[0] = bf4(acc);
  } else if (MODE == 2) {
    const vec4 gate = f4(Words(pc.gate + uint64_t(n) * 2ul).d[0]);
    precise const vec4 gated = rbf4(acc) * gate;
    precise const vec4 sum = f4(out_w.d[0]) + rbf4(gated);
    out_w.d[0] = bf4(sum);
  } else {
    out_w.d[0] = bf4(situ(rbf4(acc), rbf4(acc_gate)));
  }
}
