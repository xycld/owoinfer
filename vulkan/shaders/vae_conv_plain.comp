// The VAE's convolutions and fp32 GEMMs without cooperative matrices, 16-bit types or a particular subgroup size:
//   out[m, n] = (sum_k A[m, k] * B[n, k] + bias[n]) + residual[m, n]      (each + rounded separately, as the reference)
// with fp32 operands and accumulators, K ascending. TF32 rounds both operands to TF32 (half away from zero) first, as
// cuDNN's TF32 convolution does; their products are then exact in fp32, so only the accumulation order differs from it.
// A and B are addressed as in vae_conv_coop.comp: TAPS 9 / 1 is a 3x3 / 1x1 convolution over an NHWC input of C channels
// for an H x W output (UPSAMPLE: read through a nearest 2x upsample of an H/2 x W/2 input), TAPS 0 a row-major A with
// stride lda; B is row-major [N, K]. K, C, lda and ldb are multiples of 4. M and N are free.
//
// 256 invocations as 16 x 16; a workgroup computes a tile of 128 rows x 16 TN columns (TN 4 or 6), invocation (x, y) the
// rows 8 y .. +8 and columns TN x .. +TN, reading them from shared memory as vectors. K walks in steps of 16 through
// shared memory; the next step's global loads are issued before the current step's products.
#version 460
#extension GL_EXT_control_flow_attributes : require
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 0) const uint TAPS = 9;
layout(constant_id = 1) const bool UPSAMPLE = false;
layout(constant_id = 2) const bool TF32 = true;
layout(constant_id = 3) const uint TN = 6;  // 4 or 6

layout(buffer_reference, std430, buffer_reference_align = 16) buffer Vec4s { vec4 d[]; };

layout(push_constant) uniform PC {
  uint64_t a;
  uint64_t b;
  uint64_t out_;
  uint64_t bias;
  uint64_t residual;
  uint M;
  uint N;
  uint K;
  uint lda;
  uint ldb;
  uint ldo;
  uint H;
  uint W;
  uint C;
  uint m0;
} pc;

const uint TM = 8u;
const uint BM = 128u;
const uint BN = 16u * TN;
const uint BK = 16u;
const uint LDA_S = BM + 4u;  // floats per k row of the A tile: a multiple of 4, rows offset by 4 banks
const uint LDB_S = BN + 2u;  // a multiple of 2
shared vec4 As[BK * LDA_S / 4u];
shared vec2 Bs[BK * LDB_S / 2u];

float tf32(float v) {
  const uint u = floatBitsToUint(v);
  if ((u & 0x7f800000u) == 0x7f800000u) return v;
  return uintBitsToFloat((u + 0x1000u) & 0xffffe000u);
}
vec4 round4(vec4 v) { return TF32 ? vec4(tf32(v.x), tf32(v.y), tf32(v.z), tf32(v.w)) : v; }

vec4 load_a(uint m, uint k) {
  if (m >= pc.M || k >= pc.K) return vec4(0.0);
  uint64_t at;
  if (TAPS == 0u) {
    at = uint64_t(m) * pc.lda + k;
  } else {
    const uint tap = k / pc.C, c = k - tap * pc.C;
    if (TAPS == 1u) {
      at = uint64_t(m) * pc.C + c;
    } else {
      const uint oy = m / pc.W, ox = m - oy * pc.W;
      const int iy = int(oy) + int(tap / 3u) - 1, ix = int(ox) + int(tap % 3u) - 1;
      if (iy < 0 || ix < 0 || iy >= int(pc.H) || ix >= int(pc.W)) return vec4(0.0);
      if (UPSAMPLE) {
        at = (uint64_t(uint(iy) >> 1) * (pc.W >> 1) + (uint(ix) >> 1)) * pc.C + c;
      } else {
        at = (uint64_t(iy) * pc.W + uint(ix)) * pc.C + c;
      }
    }
  }
  return round4(Vec4s(pc.a + at * 4ul).d[0]);
}

vec4 load_b(uint n, uint k) {
  if (n >= pc.N || k >= pc.K) return vec4(0.0);
  return round4(Vec4s(pc.b + (uint64_t(n) * pc.ldb + k) * 4ul).d[0]);
}

// Chunks of 4 k values of one row: BM * 4 = 512 of A, BN * 4 <= 384 of B; invocation t takes chunks t and t + 256.
const uint B_CHUNKS = BN * 4u;

void store_a(uint chunk, vec4 v) {
  const uint row = chunk / 4u, kk = (chunk % 4u) * 4u;
  // As holds vec4s of 4 consecutive rows: scalar writes go through the vec4's components.
  const uint at = row / 4u, lane = row % 4u;
  [[unroll]] for (uint j = 0u; j < 4u; ++j) As[(kk + j) * (LDA_S / 4u) + at][lane] = v[j];
}
void store_b(uint chunk, vec4 v) {
  const uint row = chunk / 4u, kk = (chunk % 4u) * 4u;
  const uint at = row / 2u, lane = row % 2u;
  [[unroll]] for (uint j = 0u; j < 4u; ++j) Bs[(kk + j) * (LDB_S / 2u) + at][lane] = v[j];
}

void main() {
  const uint t = gl_LocalInvocationIndex;
  const uint tx = t % 16u, ty = t / 16u;
  const uint m_base = pc.m0 + gl_WorkGroupID.y * BM;
  const uint n_base = gl_WorkGroupID.x * BN;

  float acc[TM][6];
  [[unroll]] for (uint i = 0u; i < TM; ++i) {
    [[unroll]] for (uint j = 0u; j < 6u; ++j) acc[i][j] = 0.0;
  }

  vec4 ra0, ra1, rb0, rb1;
  const uint steps = (pc.K + BK - 1u) / BK;
  ra0 = load_a(m_base + t / 4u, (t % 4u) * 4u);
  ra1 = load_a(m_base + (t + 256u) / 4u, (t % 4u) * 4u);
  rb0 = load_b(n_base + t / 4u, (t % 4u) * 4u);
  rb1 = t + 256u < B_CHUNKS ? load_b(n_base + (t + 256u) / 4u, (t % 4u) * 4u) : vec4(0.0);
  for (uint step = 0u; step < steps; ++step) {
    barrier();  // the previous step's reads of As and Bs are done
    store_a(t, ra0);
    store_a(t + 256u, ra1);
    if (t < B_CHUNKS) store_b(t, rb0);
    if (t + 256u < B_CHUNKS) store_b(t + 256u, rb1);
    barrier();
    if (step + 1u < steps) {
      const uint k = (step + 1u) * BK + (t % 4u) * 4u;
      ra0 = load_a(m_base + t / 4u, k);
      ra1 = load_a(m_base + (t + 256u) / 4u, k);
      if (t < B_CHUNKS) rb0 = load_b(n_base + t / 4u, k);
      if (t + 256u < B_CHUNKS) rb1 = load_b(n_base + (t + 256u) / 4u, k);
    }
    [[unroll]] for (uint k = 0u; k < BK; ++k) {
      const vec4 a0 = As[k * (LDA_S / 4u) + ty * 2u], a1 = As[k * (LDA_S / 4u) + ty * 2u + 1u];
      const float av[8] = float[8](a0.x, a0.y, a0.z, a0.w, a1.x, a1.y, a1.z, a1.w);
      float bv[6];
      [[unroll]] for (uint q = 0u; q < 3u; ++q) {
        const vec2 b = q < TN / 2u ? Bs[k * (LDB_S / 2u) + tx * (TN / 2u) + q] : vec2(0.0);
        bv[2u * q] = b.x;
        bv[2u * q + 1u] = b.y;
      }
      [[unroll]] for (uint i = 0u; i < TM; ++i) {
        [[unroll]] for (uint j = 0u; j < 6u; ++j) {
          if (j < TN) acc[i][j] += av[i] * bv[j];
        }
      }
    }
  }

  [[unroll]] for (uint i = 0u; i < TM; ++i) {
    const uint m = m_base + ty * TM + i;
    if (m >= pc.M) continue;
    [[unroll]] for (uint j = 0u; j < 6u; ++j) {
      const uint n = n_base + tx * TN + j;
      if (j >= TN || n >= pc.N) continue;
      const uint64_t at = uint64_t(m) * pc.ldo + n;
      precise float y = acc[i][j];
      if (pc.bias != 0ul) y = y + Floats(pc.bias).d[n];
      if (pc.residual != 0ul) y = y + Floats(pc.residual + at * 4ul).d[0];
      Floats(pc.out_ + at * 4ul).d[0] = y;
    }
  }
}
